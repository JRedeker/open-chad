#!/usr/bin/env bash
# openchad: Retro tmux launcher for OpenCode
# Provides muted 80s Apple/Amiga theme, context bar, and crash isolation

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"
NO_ANIM=0

# Set up dedicated cache directory (XDG_RUNTIME_DIR/open-chad or /tmp/open-chad-$USER)
# shellcheck source=lib/opencode_env.sh
source "$LIB_DIR/opencode_env.sh"

# ─── Subcommand routing ───────────────────────────────────────────────────────
# Dispatch before main arg parsing so subcommands get clean argv.

case "${1:-}" in
    discord)
        shift
        exec bash "$LIB_DIR/discord/setup.sh" "${@:-}"
        ;;
    update)
        shift
        exec bash "$LIB_DIR/update.sh" "${@:-}"
        ;;
    version)
        shift
        exec bash "$LIB_DIR/openchad_version.sh" "${@:-}"
        ;;
    doctor)
        shift
        exec bash "$LIB_DIR/openchad_doctor.sh" "${@:-}"
        ;;
    uninstall)
        shift
        exec bash "$LIB_DIR/openchad_uninstall.sh" "${@:-}"
        ;;
    metrics)
        shift
        exec bash "$LIB_DIR/openchad_metrics.sh" "${@:-}"
        ;;
    changelog)
        shift
        exec bash "$LIB_DIR/openchad_changelog.sh" "${@:-}"
        ;;
esac

usage() {
    cat <<EOF
Usage: openchad [OPTIONS] [project-dir]
       oc       [OPTIONS] [project-dir]

Options:
  --no-anim    Skip the boot animation
  -h, --help   Show this help

Commands:
  update           Pull latest openchad changes and re-run setup
  version          Show openchad version
  doctor           Validate install health (symlinks, theme, plugins, cache)
  uninstall        Remove openchad symlinks, tmux theme block, shell profile block
  metrics log      Append timestamped metrics reading to history
  metrics export   Print current metrics as JSON
  changelog        Show git log since last tag
  changelog latest Show last tag release notes
  discord enable   Enable Discord Rich Presence (first-run wizard)
  discord disable  Disable Discord Rich Presence
  discord status   Show Discord Rich Presence status

Features:
  - Retro muted 80s Apple/Amiga theme
  - Smart tab context (ADV parsing, git branch)
  - Shared system metrics (CPU/RAM/load)
  - Tmux crash isolation
  - Optional Discord Rich Presence (openchad discord enable)

Migration note:
  The command was renamed from 'open-chad' to 'openchad' (one word, like opencode).
  If you have 'open-chad' in scripts or aliases, update them to 'openchad' or 'oc'.
  Run 'openchad doctor' to check for stale open-chad symlinks.
EOF
}

# Parse options
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-anim)
            NO_ANIM=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            args+=("$@")
            break
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

# Determine target directory for context
target_dir="$PWD"
if [ ${#args[@]} -gt 0 ]; then
    # If the first arg is a valid directory, it's our target
    if [ -d "${args[0]}" ]; then
        target_dir="$(cd "${args[0]}" && pwd)"
    fi
fi

# 1. Boot Animation
if [ "$NO_ANIM" -eq 0 ] && [ -t 1 ]; then
    "$LIB_DIR/animation.sh" "$target_dir" || true # Ignore interrupts
fi

# 2. Ensure metrics collector is running (singleton)
# Use atomic mkdir as a startup lock to prevent duplicate starts under concurrent
# launches. Named metrics-start.lock (not metrics.lock) to avoid collision with
# the collector's own PID-based lockfile at metrics.lock.
# The lockdir is removed after a 2-second delay to close the race window between
# nohup and the collector writing its PID lockfile.
_metrics_startlock="${OPEN_CHAD_CACHE_DIR}/metrics-start.lock"
if mkdir "$_metrics_startlock" 2>/dev/null; then
    nohup "$LIB_DIR/collect_metrics.sh" >/dev/null 2>&1 &
    (sleep 2; rmdir "$_metrics_startlock" 2>/dev/null || true) &
fi

# 3. Ensure Vision daemon is running (singleton)
# Uses the same two-tier locking pattern as the metrics collector:
#   - Atomic mkdir (vision-start.lock) prevents duplicate starts under concurrent launches
#   - PID lockfile (vision.lock) lets the daemon self-manage its singleton guard
# Fire-and-forget: openchad launch never blocks waiting for Vision to be ready.
# All Vision output goes to vision.log (0600) — never to the user's terminal.
if command -v vision &>/dev/null; then
    _vision_startlock="${OPEN_CHAD_CACHE_DIR}/vision-start.lock"
    if mkdir "$_vision_startlock" 2>/dev/null; then
        # Create vision.log with secure permissions before first write
        _vision_log="${OPEN_CHAD_CACHE_DIR}/vision.log"
        if [ ! -f "$_vision_log" ]; then
            install -m 0600 /dev/null "$_vision_log" 2>/dev/null || {
                touch "$_vision_log" 2>/dev/null || true
                chmod 0600 "$_vision_log" 2>/dev/null || true
            }
        fi
        # Start Vision daemon in background; it manages its own PID internally
        nohup vision daemon start >>"$_vision_log" 2>&1 &
        # Remove startup lock after 2s (same window as metrics collector)
        (sleep 2; rmdir "$_vision_startlock" 2>/dev/null || true) &
    fi
fi

# 3b. Ensure WSL Discord IPC bridge is running (WSL2 only, singleton, non-fatal)
# On WSL2, bridges Windows Discord named pipe to /tmp/discord-ipc-0 so that
# @xhayper/discord-rpc can connect from WSL to the Windows Discord client.
# _wsl_bridge_ensure is a no-op on native Linux and when deps are missing.
# Uses atomic-mkdir singleton to prevent duplicate starts under concurrent launches.
if [ -f "$LIB_DIR/discord/wsl_bridge.sh" ]; then
    # shellcheck source=lib/discord/wsl_bridge.sh
    source "$LIB_DIR/discord/wsl_bridge.sh"
    _wsl_bridge_startlock="${OPEN_CHAD_CACHE_DIR}/discord-bridge-start.lock"
    if mkdir "$_wsl_bridge_startlock" 2>/dev/null; then
        _discord_log="${OPEN_CHAD_CACHE_DIR}/discord.log"
        if [ ! -f "$_discord_log" ]; then
            install -m 0600 /dev/null "$_discord_log" 2>/dev/null || {
                touch "$_discord_log" 2>/dev/null || true
                chmod 0600 "$_discord_log" 2>/dev/null || true
            }
        fi
        # Fire-and-forget: _wsl_bridge_ensure is idempotent and always exits 0
        _wsl_bridge_ensure 2>>"$_discord_log" || true
        (sleep 2; rmdir "$_wsl_bridge_startlock" 2>/dev/null || true) &
    fi
fi

# 4. Check for tmux dependency
if ! command -v tmux &>/dev/null; then
    echo "tmux not installed - running opencode directly (no isolation or theme)"
    exec opencode "${args[@]}"
fi

# 4. Create and attach isolated session
# Unique session per invocation for crash isolation
session_name="oc-$(date +%s)-$$"

# Resolve a safe starting directory for the tmux session.
# Without an explicit -c flag, tmux inherits the cwd of the launching process.
# If that cwd is a worktree that gets deleted later, every tmux status callback
# (status_left.sh, session_title.sh, pane-border-format) spawns a shell whose
# first act is getcwd() — which fails on a deleted path, producing the noisy
# "shell-init: error retrieving current directory: getcwd: cannot access parent
# directories: No such file or directory" spam on /exit.
#
# Fallback chain: target_dir (validated) → $PWD (validated) → $HOME → /
_resolve_session_cwd() {
    local candidate
    for candidate in "$target_dir" "$PWD" "$HOME" "/"; do
        if [ -n "$candidate" ] && [ -d "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    printf '/'
}
session_cwd="$(_resolve_session_cwd)"

# Create detached session running opencode in the resolved safe directory.
# -c sets the session's default working directory so all panes and status
# callbacks start from a path that is guaranteed to exist.
# If args are provided, pass them along. Otherwise just run opencode.
if [ ${#args[@]} -gt 0 ]; then
    tmux new-session -d -s "$session_name" -c "$session_cwd" "opencode ${args[*]}"
else
    tmux new-session -d -s "$session_name" -c "$session_cwd" "opencode"
fi

# Ensure the session's pane does not linger after opencode exits.
# remain-on-exit=off means: when the command (opencode) terminates, the pane closes,
# the window closes, and the session auto-destroys. This is safe on detached sessions
# because it only fires when the *command* exits, not when a client detaches.
#
# NOTE: We intentionally do NOT use destroy-unattached here. That option kills
# detached sessions immediately — before any client can attach — causing the
# "can't find session" crash on every launch.
tmux set-option -t "$session_name" remain-on-exit off 2>/dev/null || true

# 5. Discord Rich Presence update (optional, non-blocking, SC-10: silent on failure)
# Count active openchad tmux sessions for presence display
if [ -f "$LIB_DIR/discord/update.sh" ]; then
    _discord_lock="${OPEN_CHAD_DISCORD_LOCK:-${OPEN_CHAD_CACHE_DIR}/discord-rpc.lock}"
    export OPEN_CHAD_DISCORD_LOCK="$_discord_lock"

    # One-time migration cleanup for legacy /tmp lockfiles.
    # Only remove regular files to avoid symlink-follow deletion risks.
    _legacy_discord_lock="/tmp/discord-rpc.lock"
    for _legacy_file in "$_legacy_discord_lock" "$_legacy_discord_lock.guard" "$_legacy_discord_lock.tagline"; do
        if [ -e "$_legacy_file" ] && [ ! -L "$_legacy_file" ] && [ -f "$_legacy_file" ]; then
            rm -f "$_legacy_file" 2>/dev/null || true
        fi
    done

    _discord_session_count() {
        tmux list-sessions 2>/dev/null | grep -c "^oc-" || echo 1
    }
    _discord_start_ts="${OPEN_CHAD_START_TS:-$(date +%s)}"
    _discord_elapsed=$(( $(date +%s) - _discord_start_ts ))
    _discord_sessions=$(_discord_session_count)

    # Fire-and-forget — never blocks openchad startup
    # Log stderr to a user-private cache log for troubleshooting.
    _discord_log="${OPEN_CHAD_CACHE_DIR}/discord.log"
    if [ ! -f "$_discord_log" ]; then
        install -m 0600 /dev/null "$_discord_log" 2>/dev/null || {
            touch "$_discord_log" 2>/dev/null || true
            chmod 0600 "$_discord_log" 2>/dev/null || true
        }
    fi
    # Hold presence for 8 hours by default (covers typical work session)
    # Users can override via OPEN_CHAD_DISCORD_HOLD_SEC env var
    OPEN_CHAD_DISCORD_HOLD_SEC="${OPEN_CHAD_DISCORD_HOLD_SEC:-28800}" \
        bash "$LIB_DIR/discord/update.sh" "$_discord_sessions" "$_discord_elapsed" 2>>"$_discord_log" &

    # Cleanup trap: remove lockfiles on exit
    trap 'rm -f "$OPEN_CHAD_DISCORD_LOCK" "$OPEN_CHAD_DISCORD_LOCK.guard" "$OPEN_CHAD_DISCORD_LOCK.tagline" 2>/dev/null || true' EXIT
fi

# Attach to session (replaces current process)
exec tmux attach-session -t "$session_name"
