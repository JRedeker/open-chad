#!/usr/bin/env bash
# cds — Create Date-stamped Scratch directory and launch openchad
#
# Usage:
#   cds              Create ~/scratch/YYYY-MM-DD (today) and launch openchad
#   cds 2026-01-15   Create ~/scratch/2026-01-15 and launch openchad
#   cds --help       Show this help
#
# Part of openchad. Installed to ~/.local/bin/cds by install.sh.

set -euo pipefail

# ─── Help ─────────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<EOF
Usage: cds [date]

  cds              Create ~/scratch/YYYY-MM-DD (today) and launch openchad
  cds 2026-01-15   Create ~/scratch/2026-01-15 and launch openchad

Creates the scratch directory if it doesn't exist, changes into it,
then launches openchad (the retro tmux launcher for OpenCode).
EOF
    exit 0
fi

# ─── Date resolution ──────────────────────────────────────────────────────────
DATE="${1:-$(date +%Y-%m-%d)}"
SCRATCH_DIR="$HOME/scratch/$DATE"

# ─── Create and enter scratch dir ─────────────────────────────────────────────
mkdir -p "$SCRATCH_DIR"
cd "$SCRATCH_DIR"

echo "Launching openchad in $SCRATCH_DIR"

# ─── Launch openchad ──────────────────────────────────────────────────────────
# Prefer the sibling bin/openchad (works even if PATH isn't set up yet),
# then fall back to PATH lookup.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
OPENCHAD_BIN="$SCRIPT_DIR/openchad"

if [[ -x "$OPENCHAD_BIN" ]]; then
    exec "$OPENCHAD_BIN" "$SCRATCH_DIR"
elif command -v openchad &>/dev/null; then
    exec openchad "$SCRATCH_DIR"
else
    echo "ERROR: openchad not found. Is it installed?" >&2
    echo "       Try: bash ~/dev/open-chad/install.sh" >&2
    exit 1
fi
